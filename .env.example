# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Institute & Platform Configuration
NEXT_PUBLIC_SITE_URL="https://spsolutions.in"
NEXT_PUBLIC_WHATSAPP_NUMBER="919279120271"
NEXT_PUBLIC_PHONE_NUMBER="9279120271"
NEXT_PUBLIC_INSTAGRAM_USER="santymanikpuri"
NEXT_PUBLIC_YOUTUBE_CHANNEL="makemestar.in"
NEXT_PUBLIC_GOOGLE_MAPS_URL="https://www.google.com/maps/search/?api=1&query=Village+Baloda+Hasuwa+House+359+Chhattisgarh"

# Optional Database & Storage (Supabase / PostgreSQL)
